{
  "name": "archives-paroissiales",
  "version": "1.0.0",
  "description": "Logiciel de gestion des archives de sacrements",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.js",
    "build:win": "electron-builder --win",
    "Pd": "npm run build:win"
  },
  "keywords": [],
  "author": "Paroisse MD Gérôme",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "nedb-promises": "^6.2.3"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
 "build": {
    "appId": "com.eglise.archives",
    "productName": "ArchivesSacrements",
    "files": [
      "**/*",
      "!.env",
      "!admin-password.json",
      "!*.db",
      "!dist{,/**}"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  }
}
